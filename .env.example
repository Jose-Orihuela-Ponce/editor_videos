# OAuth de una aplicación de escritorio de Google con Drive API habilitada.
# El refresh token se obtiene al autorizar tu cuenta con acceso sin conexión.
# Conservar los valores reales solo en .env; nunca usar prefijos VITE_.
# En modo Pruebas, reautorizar al caducar el refresh token (siete días).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Opcional, para elegir una carpeta Ediciones ya existente.
# Vacío permite encontrarla o crearla en Mi unidad.
GOOGLE_DRIVE_EDICIONES_FOLDER_ID=
