{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Editor",
  "version": "0.1.0",
  "identifier": "com.local.editorvideo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Editor", "width": 1320, "height": 860, "minWidth": 960, "minHeight": 640, "backgroundColor": "#141619", "dragDropEnabled": false }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
